---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  photos: ImageMetadata[];
}

const { title, photos } = Astro.props;

// Larger renditions used by the lightbox, so the full-screen view isn't
// upscaling a thumbnail or downloading the multi-megabyte original.
const fullSizes = await Promise.all(
  photos.map((photo) =>
    getImage({
      src: photo,
      width: Math.min(photo.width, 2400),
      format: "webp",
      quality: 82,
    }),
  ),
);
---

<section class="mt-8 columns-1 gap-4 sm:columns-2 lg:columns-3" id="photo-grid">
  {
    photos.map((photo, index) => (
      <figure class="mb-4 break-inside-avoid overflow-hidden rounded-2xl bg-card">
        <button
          type="button"
          class="group block w-full cursor-zoom-in appearance-none border-0 bg-transparent p-0"
          data-photo-index={index}
          data-full={fullSizes[index].src}
          data-full-width={fullSizes[index].attributes.width ?? photo.width}
          data-full-height={fullSizes[index].attributes.height ?? photo.height}
          aria-label={`Open ${title} photo ${index + 1} full screen`}
        >
          <Image
            src={photo}
            alt={`${title} photo ${index + 1}`}
            class="h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            widths={[480, 768, 1024]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading={index < 3 ? "eager" : "lazy"}
          />
        </button>
      </figure>
    ))
  }
</section>

<div
  id="photo-lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label={`${title} photo viewer`}
  hidden
>
  <button
    type="button"
    data-lightbox-close
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center text-2xl md:text-4xl leading-none text-white transition-colors hover:text-white/50"
    aria-label="Close"
  >
    ×
  </button>

  <button
    type="button"
    data-lightbox-prev
    class="absolute left-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center text-xl leading-none text-white transition-colors hover:text-white/50 md:left-2"
    aria-label="Previous photo"
  >
    ‹
  </button>

  <button
    type="button"
    data-lightbox-next
    class="absolute right-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center text-xl leading-none text-white transition-colors hover:text-white/50 md:right-2"
    aria-label="Next photo"
  >
    ›
  </button>

  <img
    data-lightbox-image
    src=""
    alt=""
    class="max-h-[87svh] max-w-[94vw] select-none rounded-lg object-contain opacity-0 transition-opacity duration-200"
  />

  <p
    data-lightbox-counter
    class="pointer-events-none absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-white/10 px-3 py-1 text-xs tracking-widest text-white/80"
  >
  </p>
</div>

<script>
  const lightbox = document.getElementById("photo-lightbox");
  const grid = document.getElementById("photo-grid");

  if (lightbox && grid) {
    const image = lightbox.querySelector<HTMLImageElement>(
      "[data-lightbox-image]",
    )!;
    const counter = lightbox.querySelector<HTMLElement>(
      "[data-lightbox-counter]",
    )!;
    const triggers = Array.from(
      grid.querySelectorAll<HTMLButtonElement>("[data-photo-index]"),
    );

    let current = -1;
    let lastFocused: HTMLElement | null = null;

    const show = (index: number) => {
      const trigger = triggers[index];
      if (!trigger) return;

      current = index;
      const src = trigger.dataset.full!;
      const alt =
        trigger.querySelector("img")?.getAttribute("alt") ?? "Photo";

      if (image.getAttribute("src") !== src) {
        image.classList.remove("opacity-100");
        image.classList.add("opacity-0");
        image.src = src;
        image.width = Number(trigger.dataset.fullWidth) || 0;
        image.height = Number(trigger.dataset.fullHeight) || 0;
      }
      image.alt = alt;
      counter.textContent = `${index + 1} / ${triggers.length}`;

      if (image.complete) reveal();
    };

    const reveal = () => {
      image.classList.remove("opacity-0");
      image.classList.add("opacity-100");
    };

    image.addEventListener("load", reveal);

    // Warm the neighbours so arrowing through feels instant.
    const preload = (index: number) => {
      const trigger = triggers[index];
      if (!trigger) return;
      const img = new window.Image();
      img.src = trigger.dataset.full!;
    };

    const open = (index: number) => {
      lastFocused = document.activeElement as HTMLElement | null;
      lightbox.hidden = false;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      show(index);
      preload(index + 1);
      preload(index - 1);
      lightbox
        .querySelector<HTMLButtonElement>("[data-lightbox-close]")
        ?.focus();
    };

    const close = () => {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lightbox.hidden = true;
      document.body.style.overflow = "";
      lastFocused?.focus();
      current = -1;
    };

    const step = (delta: number) => {
      if (current < 0) return;
      const next = (current + delta + triggers.length) % triggers.length;
      show(next);
      preload(next + delta);
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => open(index));
    });

    lightbox
      .querySelector("[data-lightbox-close]")
      ?.addEventListener("click", close);
    lightbox
      .querySelector("[data-lightbox-prev]")
      ?.addEventListener("click", () => step(-1));
    lightbox
      .querySelector("[data-lightbox-next]")
      ?.addEventListener("click", () => step(1));

    // Clicking the backdrop (but not the photo or the controls) closes.
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) close();
    });

    document.addEventListener("keydown", (event) => {
      if (lightbox.hidden) return;
      if (event.key === "Escape") close();
      else if (event.key === "ArrowLeft") step(-1);
      else if (event.key === "ArrowRight") step(1);
    });

    // Swipe between photos on touch devices.
    let touchStartX = 0;
    let touchStartY = 0;
    lightbox.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].clientX;
        touchStartY = event.changedTouches[0].clientY;
      },
      { passive: true },
    );
    lightbox.addEventListener(
      "touchend",
      (event) => {
        const dx = event.changedTouches[0].clientX - touchStartX;
        const dy = event.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          step(dx < 0 ? 1 : -1);
        }
      },
      { passive: true },
    );
  }
</script>
