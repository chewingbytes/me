---
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import PhotoGallery from "@/components/PhotoGallery.astro";

const title = "Japan";

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/japan/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const photos = Object.values(photoModules)
  .map((mod) => mod.default)
  .sort((a, b) => a.src.localeCompare(b.src, undefined, { numeric: true }));
---

<Layout>
  <main
    class="mx-auto flex h-svh w-full max-w-7xl flex-col overflow-y-auto px-4 py-6 md:px-8 md:py-10"
  >
    <a
      href="/?screen=photography"
      class="inline-flex w-fit items-center gap-2 rounded-full bg-card px-4 py-2 text-xs uppercase tracking-widest text-muted-foreground transition-colors hover:bg-muted"
    >
      ← Back
    </a>

    <header class="mt-6 flex flex-col gap-2">
      <p
        class="text-md sm:text-lg uppercase tracking-widest text-muted-foreground"
      >
        Photography
      </p>
      <h1
        class="text-8xl sm:text-9xl font-thin md:text-9xl tracking-tighter leading-none"
      >
        {title}
      </h1>
      <p class="text-sm text-muted-foreground">{photos.length} photos</p>
    </header>

    <PhotoGallery title={title} photos={photos} />
  </main>
</Layout>
