---
import Layout from "../layouts/Layout.astro";
import CarouselMain from "@/components/CarouselMain";
import { frontmatterToScreen, type ScreenFrontmatter } from "@/lib/content";

const order = ["homepage", "projects", "photography"];

const mdFiles = import.meta.glob<{ frontmatter: ScreenFrontmatter }>(
  "../content/*.md",
  { eager: true },
);

const screens = Object.values(mdFiles)
  .map((f) => frontmatterToScreen(f.frontmatter))
  .sort((a, b) => order.indexOf(a._key) - order.indexOf(b._key));
---

<Layout>
  <div class="relative h-svh w-full overflow-hidden">
    <a
      href="/cv"
      class="absolute right-4 top-4 z-30 inline-flex items-center rounded-full border border-border bg-background px-3 py-1.5 text-xs font-semibold uppercase tracking-widest text-foreground shadow-sm ring-1 ring-black/5 backdrop-blur transition-all hover:-translate-y-0.5 md:right-6 md:top-6"
    >
      View my CV <span style="transform: translateX(2px) translateY(-2px);"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-arrow-up-right"
          aria-hidden="true"
          ><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg
        ></span
      >
    </a>
    <CarouselMain client:load screens={screens} />
  </div>
</Layout>
